#card_container {
    background-color: #0b2230;
    border: 1px solid #163a4e;
    border-radius: 12px;
    min-width: 280px;
    max-width: 320px;
}

#label_icone {
    background-color: #00a8e8;
    color: #0b2230;
    font-size: 14px;
    font-weight: bold;
    border-radius: 11px;
    min-width: 22px;
    max-width: 22px;
    min-height: 22px;
    max-height: 22px;
    qproperty-alignment: 'AlignCenter';
}

#label_titulo {
    color: #ffffff;
    font-size: 16px;
    font-weight: bold;
}

#label_mensagem {
    color: #a0b8c6;
    font-size: 12px;
}

#botao_ok {
    background-color: #0091ea;
    color: #ffffff;
    font-size: 12px;
    font-weight: bold;
    border: none;
    border-radius: 4px;
    padding: 6px 30px;
}

#botao_ok:hover {
    background-color: #00a0ff;
}

#botao_ok:pressed {
    background-color: #0077c2;
}