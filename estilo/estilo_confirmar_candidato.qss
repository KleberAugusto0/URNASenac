QDialog#tela_confirmar_candidato {
    background-color: #12203A;
}

QFrame#card_confirmar_candidato {
    background-color: #0B1A2E;
    border: 1px solid #1F5F99;
    border-radius: 12px;
}
QFrame#card_confirmar_candidato {
    background-color: #0B1A2E;
    border: 1px solid #1F5F99;
    border-radius: 12px;
}

QLabel#lbl_icone {
    background: transparent;
}

QLabel#lbl_titulo {
    color: #FFFFFF;
    font-size: 20px;
    font-weight: bold;
    background: transparent;
}

QLabel#lbl_mensagem {
    color: #E6EDF5;
    font-size: 13px;
    background: transparent;
}

QPushButton#btn_ok {
    background-color: #1877F2;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: bold;
    border: none;
    border-radius: 6px;
}

QPushButton#btn_confirmar {
    background-color: #1877F2;
    height: 40px;
    width: 30px;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: bold;
    border: none;
    border-radius: 6px;
}
QPushButton#btn_cancelar {
    background-color: gray;
    height: 40px;
    width: 30px;
    color: #FFFFFF;
    font-size: 14px;
    font-weight: bold;
    border: none;
    border-radius: 6px;
}

QLabel#lbl_mensagem{
    color: #93B9D6;
}


QPushButton#btn_ok:hover   { background-color: #2E88FF; }
QPushButton#btn_ok:pressed { background-color: #1266D6; }

QPushButton#btn_confirmar:hover   { background-color: #2E88FF; }
QPushButton#btn_confirmar:pressed { background-color: #1266D6; }

QPushButton#btn_fechar {
    background: transparent;
    color: #FFFFFF;
    font-size: 16px;
    border: none;
}
QPushButton#btn_fechar:hover {
    color: #8FB8E8;
}


