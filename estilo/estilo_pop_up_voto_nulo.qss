QDialog#tela_voto_nulo {
    background-color: transparent;
}


QFrame#card_voto_nulo {
    background-color: #05192F;
    border: 2px solid #123559;
    border-radius: 12px;
}

QLabel#lbl_icone {
    background: transparent;
}

QLabel#lbl_titulo {
    color: #F0FDFF;
    font-size: 20px;
    font-weight: bold;
    background: transparent;
}

QLabel#lbl_mensagem {
    color: #93B9D6;
    font-size: 13px;
    background: transparent;
}

QPushButton#btn_fechar {
    background: transparent;
    color: #93B9D6;
    font-size: 16px;
    border: none;
}

QPushButton#btn_fechar:hover {
    color: #D62039;
}

QPushButton#btn_cancelar {
    background-color: #334A68;
    color: #F0FDFF;
    font-size: 14px;
    font-weight: bold;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    min-height: 36px;
}

QPushButton#btn_cancelar:hover {
    background-color: #425e83;
}

 
QPushButton#btn_confirmar {
    background-color: #056CE7;
    color: #F0FDFF;
    font-size: 14px;
    font-weight: bold;
    border: none;
    border-radius: 6px;
    padding: 8px 16px;
    min-height: 36px;
}

QPushButton#btn_confirmar:hover {
    background-color: #2E88FF;
}

QPushButton#btn_confirmar:pressed {
    background-color: #1266D6;
}